## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio cache/options directory
.vs/

# Test results
TestResults/
[Tt]est[Rr]esult*/
*.trx
coverage.cobertura.xml
*.coverage
*.coveragexml

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*

# Publish folder
publish/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini
